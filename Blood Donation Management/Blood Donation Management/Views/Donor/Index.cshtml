@{
}

<form action="/" method="post">
    <label>Enter Donor Full Name</label>
    <input type="text" name="FullName" placeholder="Enter Donor Name"/>  <br />
    <label>Enter Donor Blood Group</label>
    <input type="text" name="BloodGroup" placeholder="Enter Donor Blood Group" /> <br />
    <label>Enter Donor Contact No</label>
    <input type="text" name="ContactNo" placeholder="Enter Donor Contact" /> <br />
    <label>Enter Donor City</label>
    <input type="text" name="city" placeholder="Enter Donor city" /> <br />
    <label>Enter Donor Last Donation Date</label>
    <input type="date" name="LastDonationDate" /> <br />
    <button type="submit">Submit</button>
</form>