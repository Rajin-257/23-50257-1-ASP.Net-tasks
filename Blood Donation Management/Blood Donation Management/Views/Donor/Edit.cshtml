@model DonorModel

<form action="/Donor/Edit" method="post">
    <input type="hidden" name="DonorId" value="@Model.DonorId" />
    <label>Enter Donor Full Name</label>
    <input type="text" name="FullName" value="@Model.FullName" placeholder="Enter Donor Name" />  <br />
    <span class="text-danger">@Html.ValidationMessage("FullName")</span> <br />
    <label>Enter Donor Blood Group</label>
    <input type="text" name="BloodGroup" value="@Model.BloodGroup" placeholder="Enter Donor Blood Group" /> <br />
    <span class="text-danger">@Html.ValidationMessage("BloodGroup")</span> <br />
    <label>Enter Donor Contact No</label>
    <input type="text" name="ContactNo" value="@Model.ContactNo" placeholder="Enter Donor Contact" /> <br />
    <span class="text-danger">@Html.ValidationMessage("ContactNo")</span> <br />
    <label>Enter Donor City</label>
    <input type="text" name="city" value="@Model.city" placeholder="Enter Donor city" /> <br />
    <span class="text-danger">@Html.ValidationMessage("city")</span> <br />
    <label>Enter Donor Last Donation Date</label>
    <input type="date" name="LastDonationDate" value="@Model.LastDonationDate.ToString("yyyy-MM-dd")" /> <br />
    <span class="text-danger">@Html.ValidationMessage("LastDonationDate")</span> <br />
    <button type="submit">Update</button>
    <a href="/Donor">Cancel</a>
</form>
