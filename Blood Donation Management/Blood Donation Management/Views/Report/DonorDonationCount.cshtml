@model List<DonorDonationCountModel>

@if (Model != null && Model.Count != 0)
{
    <table>
        <tr>
            <th>Id</th>
            <th>Full Name</th>
            <th>Blood Group</th>
            <th>Total Donations</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DonorId</td>
                <td>@item.FullName</td>
                <td>@item.BloodGroup</td>
                <td>@item.TotalDonations</td>
            </tr>
        }
    </table>
}
